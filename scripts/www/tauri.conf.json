{
    "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/heads/dev/core/tauri-config-schema/schema.json",
    "productName": "正商诸葛AI",
    "version": "1.2.0",
    "identifier": "com.zsag.ai",
    "build": {
        "frontendDist": ".",
        "devUrl": "http://localhost:1420"
    },
    "app": {
        "windows": [
            {
                "title": "正商诸葛AI",
                "width": 420,
                "height": 800,
                "resizable": true,
                "center": true,
                "minWidth": 360,
                "minHeight": 640,
                "decorations": true,
                "fullscreen": false,
                "transparent": false
            }
        ],
        "security": {
            "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss:; font-src 'self' data: https:"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["msi", "nsis", "app", "dmg", "deb", "rpm"],
        "identifier": "com.zsag.ai",
        "icon": [
            "static/icon.png"
        ]
    }
}
